{
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk",
      "command": "latexmk",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-halt-on-error",
        "-pdf",
        "-outdir=%OUTDIR%",
        "%DOC_EXT%"
      ]
    },
    {
      "name": "tinytex-latexmk",
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "%WORKSPACE_FOLDER%/.vscode/build-latex.ps1",
        "-RootFile",
        "%DOC_EXT%",
        "-OutputDirectory",
        "%OUTDIR%"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk (pdfLaTeX)",
      "tools": [
        "latexmk"
      ]
    },
    {
      "name": "TinyTeX (Windows)",
      "tools": [
        "tinytex-latexmk"
      ]
    }
  ],
  "latex-workshop.latex.recipe.default": "latexmk (pdfLaTeX)",
  "latex-workshop.latex.clean.command": "latexmk",
  "latex-workshop.kpsewhich.path": "kpsewhich"
}
